{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "dist-ssr/**",
    "dev-dist/**",
    "coverage/**",
    "legacy/**",
    "cypress/screenshots/**",
    "cypress/videos/**",
    "cypress/downloads/**",
    "**/*.vue.js",
    "**/*.vue.js.map"
  ],
  "categories": {
    "correctness": "warn"
  }
}
